// Hospedagem no Cloudflare (Workers com arquivos estáticos). O build gera dist/; aqui só se publica o que está lá.
{
  "name": "bankmar",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // SPA: qualquer rota (inclusive /c/<token> dos links de consulta) abre o app
    "not_found_handling": "single-page-application"
  }
}
